# Exemplo de configuração Nginx para o homelab
# Salve em /etc/nginx/sites-available/unicep.muriloscolari.me e ative com Certbot/SSL

server {
    listen 80;
    listen [::]:80;
    server_name unicep.muriloscolari.me;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name unicep.muriloscolari.me;

    # Certificados gerenciados pelo Certbot ou seu ACME client
    ssl_certificate     /etc/letsencrypt/live/unicep.muriloscolari.me/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/unicep.muriloscolari.me/privkey.pem;

    # Cabeçalhos de segurança básicos
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Necessário para arquivos .wasm e compressão gzip/brotli eficiente
    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/wasm;

    location / {
        proxy_pass http://127.0.0.1:47832;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }
}
