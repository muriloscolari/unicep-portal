# Porta rara interna do backend no homelab
PORT=47832
BIND_HOST=127.0.0.1

# Chave secreta de 32+ bytes para assinar JWT e criptografar credenciais (AES-256-GCM)
# Gere com: openssl rand -hex 32
APP_SECRET=troque-por-uma-chave-secreta-aleatoria-com-64-caracteres-hex

# Origem permitida para CORS (em produção: https://unicep.muriloscolari.me)
CORS_ORIGIN=https://unicep.muriloscolari.me

# Diretório do banco SQLite dentro do container
DATA_DIR=/app/data

# Diretório do bundle estático Web Wasm (vazio = desabilita static server)
WEB_DIR=/app/web

# Intervalo do worker de polling de notas (em minutos)
POLL_INTERVAL_MINUTES=15

# Se true, também gera notificação quando aumentar o número de faltas (FA)
NOTIFY_ABSENCES=true
